          { time: "10:10~11:40", title: "白色戀人博物館", transport: "地鐵", tClass: "t-train", must: true },
          { time: "12:00~13:30", title: "場外市場 - 三上商店（帝王蟹和海鮮丼）", transport: "計程車", tClass: "t-taxi", must: true },
          { time: "14:00~15:30", title: "北海道大學（冬季雪景校園）", transport: "步行", tClass: "t-walk" },
          { time: "16:00~17:00", title: "Espresso D'Works 下午茶", transport: "步行", tClass: "t-walk" },
          { time: "17:00~17:50", title: "回飯店休息", transport: "步行", tClass: "t-walk" },
          { time: "18:00~19:30", title: "薄野燒肉喜樂", transport: "步行", tClass: "t-walk" },
          { time: "20:00~21:00", title: "大通公園聖誕活動（燈飾市集）", transport: "步行", tClass: "t-walk", must: true }
        ]
      },
      {
        date: "12月26日", weekday: "週六 Day 8", theme: "新千歲機場伴手禮衝刺・平安返台",
        items: [
          { time: "08:00~09:30", title: "飯店早餐", transport: "飯店內", tClass: "t-walk" },
          { time: "09:30~10:00", title: "札幌 STREAM 飯店退房", transport: "飯店內", tClass: "t-walk" },
          { time: "10:00~10:40", title: "前往新千歲機場", transport: "JR快速", tClass: "t-train" },
          { time: "10:40~12:00", title: "新千歲機場伴手禮最後衝刺", transport: "步行", tClass: "t-walk", must: true },
          { time: "12:00~13:30", title: "機場貴賓室休息吃飯", transport: "步行", tClass: "t-walk" },
          { time: "14:40~18:15", title: "搭乘中華航空 CI0131 回台北桃園", transport: "航班", tClass: "t-plane" }
        ]
      }
    ];

    function updateCountdown() {
      const target = new Date("2026-12-19T08:35:00+08:00").getTime();
      const endTrip = new Date("2026-12-26T18:15:00+08:00").getTime();
      const now = Date.now();
      const statusEl = document.getElementById("cd-status");
      const daysEl = document.getElementById("cd-days");
      const hoursEl = document.getElementById("cd-hours");
      const minsEl = document.getElementById("cd-mins");

      if (now < target) {
        const diff = target - now;
        daysEl.textContent = Math.floor(diff / (1000 * 60 * 60 * 24));
        hoursEl.textContent = String(Math.floor((diff / (1000 * 60 * 60)) % 24)).padStart(2, "0");
        minsEl.textContent = String(Math.floor((diff / (1000 * 60)) % 60)).padStart(2, "0");
      } else if (now <= endTrip) {
        statusEl.textContent = "北海道之旅快樂進行中！";
        daysEl.textContent = "0"; hoursEl.textContent = "00"; minsEl.textContent = "00";
      } else {
        statusEl.textContent = "美好的北海道冬日回憶已收藏";
        daysEl.textContent = "END"; hoursEl.textContent = "♥"; minsEl.textContent = "❄";
      }
    }
    updateCountdown();
    setInterval(updateCountdown, 30000);

    const tabsContainer = document.getElementById("day-tabs");
    const contentContainer = document.getElementById("day-content");
    let currentDayIndex = 0;

    function renderDayTabs() {
      tabsContainer.innerHTML = "";
      itineraryData.forEach((day, idx) => {
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "day-tab" + (idx === currentDayIndex ? " active" : "");
        btn.setAttribute("role", "tab");
        btn.innerHTML = `<strong>${day.date}</strong><span>${day.weekday}</span>`;
        btn.addEventListener("click", () => {
          if (currentDayIndex === idx) return;
          currentDayIndex = idx;
          renderDayTabs();
          renderDayContent(true);
          btn.scrollIntoView({ behavior: "smooth", inline: "center", block: "nearest" });
        });
        tabsContainer.appendChild(btn);
      });
    }

    function renderDayContent(animate = false) {
      const day = itineraryData[currentDayIndex];
      const itemsHtml = day.items.map(item => {
        const mustBadge = item.must ? `<span class="must-badge">★ 必去</span>` : "";
        const sublistHtml = item.sublist ? `<ul class="tl-sublist">${item.sublist.map(s => `<li>${s}</li>`).join("")}</ul>` : "";
        return `
          <div class="tl-item ${item.must ? "must-go" : ""}">
            <div class="tl-top">
              <span class="tl-time">${item.time}</span>
              <span class="transport-tag ${item.tClass}">${item.transport}</span>
              ${mustBadge}
            </div>
            <div class="tl-title">${item.title}</div>
            ${sublistHtml}
          </div>
        `;
      }).join("");

      contentContainer.innerHTML = `
        <div class="${animate ? "bounce-in" : ""}">
          <div class="day-header-banner">
            <div>
              <h3>${day.date}（${day.weekday}）</h3>
              <p>${day.theme}</p>
            </div>
            <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="#3E3A39" stroke-width="2.5" stroke-linecap="round">
              <circle cx="12" cy="12" r="9" fill="#FFFCF6"/><path d="M12 7v5l3 3"/>
            </svg>
          </div>
          <div class="timeline">${itemsHtml}</div>
        </div>
      `;
    }

    renderDayTabs();
    renderDayContent(false);

    const STORAGE_KEY = "hokkaido_2026_todos_v3";
    const defaultTodos = [
      { text: "確認護照效期（需六個月以上）與 Visit Japan Web 登錄", done: false },
      { text: "預訂 JR 特急北斗號指定席車票", done: false },
      { text: "準備雪地防滑鞋套、發熱衣、毛帽與暖暖包", done: false },
      { text: "日本上網 SIM 卡 / eSIM 與日幣現金", done: false },
      { text: "新千歲機場伴手禮清單：六花亭、LeTAO、白色戀人", done: false }
    ];

    let todos = JSON.parse(localStorage.getItem(STORAGE_KEY)) || defaultTodos;

    function saveTodos() { localStorage.setItem(STORAGE_KEY, JSON.stringify(todos)); }

    function renderTodos() {
      const listEl = document.getElementById("todo-list");
      listEl.innerHTML = "";
      todos.forEach((todo, index) => {
        const li = document.createElement("li");
        li.className = "todo-item" + (todo.done ? " done" : "");
        li.innerHTML = `
          <div class="todo-checkbox">
            ${todo.done ? `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#3E3A39" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>` : ""}
          </div>
          <span class="todo-text">${escapeHtml(todo.text)}</span>
          <button type="button" class="todo-del">✕</button>
        `;
        li.addEventListener("click", (e) => {
          if (e.target.classList.contains("todo-del")) return;
          todos[index].done = !todos[index].done;
          saveTodos(); renderTodos();
        });
        li.querySelector(".todo-del").addEventListener("click", () => {
          todos.splice(index, 1);
          saveTodos(); renderTodos();
        });
        listEl.appendChild(li);
      });
    }

    function escapeHtml(str) {
      return str.replace(/[&<>"']/g, m => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[m]));
    }

    const todoInput = document.getElementById("todo-input");
    const todoAddBtn = document.getElementById("todo-add");

    function addTodo() {
      const val = todoInput.value.trim();
      if (!val) return;
      todos.unshift({ text: val, done: false });
      todoInput.value = "";
      saveTodos(); renderTodos();
    }

    todoAddBtn.addEventListener("click", addTodo);
    todoInput.addEventListener("keydown", (e) => { if (e.key === "Enter") addTodo(); });
    renderTodos();
  </script>
</body>
</html>
