<!DOCTYPE html>
<html lang="zh-Hant">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>北海道冬日繪本之旅 2026｜12/19 - 12/26</title>
  <!-- Google Fonts: Huninn -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Huninn&display=swap" rel="stylesheet" />

  <style>
    :root {
      --bg-washi: #FFFCF6;
      --ink: #3E3A39;
      --coral: #F2A497;
      --yamabuki: #F6D27A;
      --mizu: #A8D3E6;
      --wakatake: #B9DAA5;
      --white: #FFFFFF;
      --border-w: 3px;
      --radius-lg: 24px;
      --radius-md: 16px;
      --radius-pill: 999px;
      --shadow-solid: 4px 4px 0px #3E3A39;
      --shadow-sm: 2px 2px 0px #3E3A39;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
      font-family: 'Huninn', -apple-system, BlinkMacSystemFont, "Microsoft JhengHei", sans-serif;
      background-color: var(--bg-washi);
      color: var(--ink);
    }

    body {
      background-color: var(--bg-washi);
      background-image: radial-gradient(#3E3A3918 1.2px, transparent 1.2px);
      background-size: 20px 20px;
      line-height: 1.6;
      padding-top: 68px;
      padding-bottom: 48px;
    }

    /* 頂端固定選單 */
    .top-nav {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 100;
      background-color: var(--bg-washi);
      border-bottom: var(--border-w) solid var(--ink);
      padding: 10px 12px;
      display: flex;
      justify-content: center;
    }

    .nav-inner {
      width: 100%;
      max-width: 680px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 6px;
    }

    .nav-brand {
      font-size: 1.05rem;
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 6px;
      white-space: nowrap;
    }

    .nav-links {
      display: flex;
      gap: 6px;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .nav-links::-webkit-scrollbar {
      display: none;
    }

    .nav-links a {
      text-decoration: none;
      color: var(--ink);
      font-size: 0.85rem;
      padding: 5px 11px;
      border: 2.5px solid var(--ink);
      border-radius: var(--radius-pill);
      background-color: var(--white);
      white-space: nowrap;
      transition: transform 0.15s ease, background-color 0.15s ease;
    }

    .nav-links a:hover,
    .nav-links a:active {
      background-color: var(--yamabuki);
      transform: translateY(-2px);
    }

    /* 主容器 */
    .container {
      width: 100%;
      max-width: 680px;
      margin: 0 auto;
      padding: 16px;
      display: flex;
      flex-direction: column;
      gap: 28px;
    }

    .ehon-card {
      background-color: var(--white);
      border: var(--border-w) solid var(--ink);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-solid);
      padding: 20px 18px;
    }

    .section-title {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 1.3rem;
      background-color: var(--yamabuki);
      border: var(--border-w) solid var(--ink);
      border-radius: var(--radius-pill);
      box-shadow: var(--shadow-sm);
      padding: 6px 18px;
      margin-bottom: 16px;
    }

    .section-title.coral { background-color: var(--coral); }
    .section-title.mizu { background-color: var(--mizu); }
    .section-title.wakatake { background-color: var(--wakatake); }

    /* 首頁 Hero 區塊 */
    .hero-card {
      background-color: var(--mizu);
      text-align: center;
      position: relative;
      overflow: hidden;
      padding: 24px 16px 22px;
    }

    .hero-badge {
      display: inline-block;
      background-color: var(--bg-washi);
      border: 2.5px solid var(--ink);
      border-radius: var(--radius-pill);
      padding: 4px 14px;
      font-size: 0.9rem;
      margin-bottom: 10px;
      box-shadow: var(--shadow-sm);
    }

    .hero-title {
      font-size: 1.85rem;
      line-height: 1.3;
      margin-bottom: 6px;
      letter-spacing: 0.03em;
    }

    .hero-subtitle {
      font-size: 1rem;
      margin-bottom: 14px;
    }

    .hero-svg-wrap {
      max-width: 340px;
      margin: 0 auto 16px;
      background-color: var(--bg-washi);
      border: var(--border-w) solid var(--ink);
      border-radius: var(--radius-lg);
      padding: 10px 10px 4px;
      box-shadow: var(--shadow-sm);
    }

    /* 倒數計時器 */
    .countdown-box {
      background-color: var(--bg-washi);
      border: var(--border-w) solid var(--ink);
      border-radius: var(--radius-md);
      padding: 12px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
    }

    .countdown-label {
      font-size: 0.92rem;
      background-color: var(--coral);
      border: 2px solid var(--ink);
      border-radius: var(--radius-pill);
      padding: 2px 12px;
    }

    .countdown-grid {
      display: flex;
      gap: 10px;
      justify-content: center;
      flex-wrap: wrap;
    }

    .cd-item {
      background-color: var(--yamabuki);
      border: 2.5px solid var(--ink);
      border-radius: 14px;
      min-width: 64px;
      padding: 6px 10px;
      text-align: center;
      box-shadow: var(--shadow-sm);
    }

    .cd-num {
      font-size: 1.45rem;
      font-weight: 700;
      display: block;
      line-height: 1.1;
    }

    .cd-unit {
      font-size: 0.78rem;
    }

    /* 航班卡片 */
    .flight-list {
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .flight-ticket {
      background-color: var(--bg-washi);
      border: var(--border-w) solid var(--ink);
      border-radius: var(--radius-md);
      padding: 14px 16px;
    }

    .flight-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 10px;
      padding-bottom: 8px;
      border-bottom: 2.5px dashed var(--ink);
    }

    .flight-tag {
      background-color: var(--coral);
      border: 2px solid var(--ink);
      border-radius: var(--radius-pill);
      padding: 2px 12px;
      font-size: 0.85rem;
    }

    .flight-tag.return {
      background-color: var(--wakatake);
    }

    .flight-code {
      font-size: 1.05rem;
      font-weight: 700;
    }

    .flight-route {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      text-align: center;
    }

    .airport-box {
      flex: 1;
    }

    .airport-code {
      font-size: 1.35rem;
      font-weight: 700;
    }

    .airport-name {
      font-size: 0.85rem;
    }

    .flight-time {
      display: inline-block;
      margin-top: 4px;
      background-color: var(--yamabuki);
      border: 2px solid var(--ink);
      border-radius: 10px;
      padding: 2px 10px;
      font-size: 0.95rem;
    }

    .flight-plane-icon {
      flex-shrink: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      font-size: 0.78rem;
    }

    /* 每日行程日期切換器 */
    .day-tabs {
      display: flex;
      gap: 8px;
      overflow-x: auto;
      padding: 4px 2px 12px;
      margin-bottom: 8px;
      scrollbar-width: none;
    }
    .day-tabs::-webkit-scrollbar {
      display: none;
    }

    .day-tab {
      flex-shrink: 0;
      cursor: pointer;
      font-family: inherit;
      font-size: 0.92rem;
      color: var(--ink);
      background-color: var(--bg-washi);
      border: var(--border-w) solid var(--ink);
      border-radius: 16px;
      padding: 8px 14px;
      text-align: center;
      box-shadow: var(--shadow-sm);
      transition: background-color 0.15s ease, transform 0.15s ease;
    }

    .day-tab span {
      display: block;
      font-size: 0.78rem;
    }

    .day-tab.active {
      background-color: var(--yamabuki);
      transform: translateY(-2px);
    }

    .day-header-banner {
      background-color: var(--mizu);
      border: var(--border-w) solid var(--ink);
      border-radius: var(--radius-md);
      padding: 12px 14px;
      margin-bottom: 18px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
    }

    .day-header-banner h3 {
      font-size: 1.15rem;
    }

    .day-header-banner p {
      font-size: 0.88rem;
    }

    /* 時間軸 */
    .timeline {
      position: relative;
      padding-left: 24px;
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .timeline::before {
      content: "";
      position: absolute;
      left: 7px;
      top: 8px;
      bottom: 8px;
      width: 3px;
      background-color: var(--ink);
      border-radius: 3px;
    }

    .tl-item {
      position: relative;
      background-color: var(--bg-washi);
      border: 2.5px solid var(--ink);
      border-radius: var(--radius-md);
      padding: 12px 14px;
    }

    .tl-item::before {
      content: "";
      position: absolute;
      left: -23px;
      top: 16px;
      width: 14px;
      height: 14px;
      background-color: var(--coral);
      border: 3px solid var(--ink);
      border-radius: 50%;
    }

    .tl-item.must-go {
      background-color: #FFF6E5;
      border-width: 3px;
    }

    .tl-item.must-go::before {
      background-color: var(--yamabuki);
    }

    .tl-top {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 6px;
      margin-bottom: 6px;
    }

    .tl-time {
      font-size: 0.9rem;
      font-weight: 700;
      background-color: var(--white);
      border: 2px solid var(--ink);
      border-radius: 10px;
      padding: 1px 9px;
    }

    .transport-tag {
      font-size: 0.78rem;
      padding: 2px 9px;
      border: 2px solid var(--ink);
      border-radius: var(--radius-pill);
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }
    .t-plane { background-color: var(--mizu); }
    .t-train { background-color: var(--wakatake); }
    .t-taxi  { background-color: var(--yamabuki); }
    .t-bus   { background-color: var(--coral); }
    .t-walk  { background-color: var(--white); }

    .must-badge {
      font-size: 0.78rem;
      font-weight: 700;
      background-color: var(--coral);
      border: 2px solid var(--ink);
      border-radius: var(--radius-pill);
      padding: 2px 10px;
      margin-left: auto;
    }

    .tl-title {
      font-size: 1.05rem;
      line-height: 1.45;
    }

    .tl-sublist {
      margin-top: 6px;
      padding-left: 18px;
      font-size: 0.95rem;
    }

    /* 住宿資訊卡片 */
    .hotel-grid {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .hotel-card {
      background-color: var(--bg-washi);
      border: 2.5px solid var(--ink);
      border-radius: var(--radius-md);
      padding: 14px;
      display: flex;
      gap: 12px;
      align-items: flex-start;
    }

    .hotel-icon {
      width: 46px;
      height: 46px;
      flex-shrink: 0;
      background-color: var(--wakatake);
      border: 2.5px solid var(--ink);
      border-radius: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .hotel-nights {
      display: inline-block;
      font-size: 0.8rem;
      background-color: var(--yamabuki);
      border: 2px solid var(--ink);
      border-radius: var(--radius-pill);
      padding: 1px 10px;
      margin-bottom: 4px;
    }

    .hotel-name {
      font-size: 1.05rem;
      font-weight: 700;
    }

    .hotel-note {
      font-size: 0.88rem;
      margin-top: 2px;
    }

    /* 景點餐廳寫真相簿頁面樣式 */
    .photo-gallery-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 18px;
      margin-top: 8px;
    }

    .polaroid-card {
      background-color: var(--bg-washi);
      border: 2.5px solid var(--ink);
      border-radius: 16px;
      padding: 12px 12px 16px;
      box-shadow: var(--shadow-sm);
      display: flex;
      flex-direction: column;
      gap: 10px;
      transition: transform 0.2s ease;
    }

    .polaroid-card:hover {
      transform: translateY(-4px);
    }

    .polaroid-img-box {
      width: 100%;
      height: 160px;
      border: 2.5px solid var(--ink);
      border-radius: 12px;
      overflow: hidden;
      background-color: var(--white);
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .polaroid-img-box img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .polaroid-info {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .polaroid-tag {
      align-self: flex-start;
      font-size: 0.75rem;
      background-color: var(--yamabuki);
      border: 2px solid var(--ink);
      border-radius: var(--radius-pill);
      padding: 1px 10px;
    }

    .polaroid-title {
      font-size: 1.05rem;
      font-weight: 700;
    }

    .polaroid-desc {
      font-size: 0.85rem;
      opacity: 0.85;
    }

    /* 待辦清單 */
    .todo-input-row {
      display: flex;
      gap: 8px;
      margin-bottom: 14px;
    }

    .todo-input {
      flex: 1;
      font-family: inherit;
      font-size: 0.95rem;
      padding: 9px 14px;
      background-color: var(--bg-washi);
      border: 2.5px solid var(--ink);
      border-radius: var(--radius-pill);
      color: var(--ink);
      outline: none;
    }

    .todo-add-btn {
      font-family: inherit;
      font-size: 0.95rem;
      background-color: var(--coral);
      color: var(--ink);
      border: 2.5px solid var(--ink);
      border-radius: var(--radius-pill);
      padding: 8px 16px;
      cursor: pointer;
      box-shadow: var(--shadow-sm);
    }

    .todo-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .todo-item {
      display: flex;
      align-items: center;
      gap: 10px;
      background-color: var(--bg-washi);
      border: 2.5px solid var(--ink);
      border-radius: 14px;
      padding: 10px 14px;
      cursor: pointer;
      user-select: none;
    }

    .todo-checkbox {
      width: 24px;
      height: 24px;
      flex-shrink: 0;
      border: 2.5px solid var(--ink);
      border-radius: 8px;
      background-color: var(--white);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .todo-item.done {
      background-color: #EFECE6;
    }

    .todo-item.done .todo-checkbox {
      background-color: var(--wakatake);
    }

    .todo-item.done .todo-text {
      text-decoration: line-through;
      opacity: 0.65;
    }

    .todo-text {
      flex: 1;
      font-size: 0.98rem;
    }

    .todo-del {
      background: none;
      border: none;
      font-family: inherit;
      font-size: 1rem;
      color: var(--ink);
      cursor: pointer;
      padding: 2px 6px;
      opacity: 0.6;
    }
    .todo-del:hover {
      opacity: 1;
    }

    /* 動畫與無障礙設定 */
    @keyframes gentleFloat {
      0%, 100% { transform: translateY(0px); }
      50% { transform: translateY(-5px); }
    }

    @keyframes swaySlow {
      0%, 100% { transform: rotate(-2deg); }
      50% { transform: rotate(2deg); }
    }

    @keyframes popBounce {
      0%   { opacity: 0; transform: scale(0.95) translateY(10px); }
      60%  { opacity: 1; transform: scale(1.02) translateY(-3px); }
      80%  { transform: scale(0.99) translateY(1px); }
      100% { opacity: 1; transform: scale(1) translateY(0); }
    }

    .svg-float { animation: gentleFloat 3.4s ease-in-out infinite; }
    .svg-sway { transform-origin: center; animation: swaySlow 4s ease-in-out infinite; }
    .bounce-in { animation: popBounce 0.42s cubic-bezier(0.22, 1, 0.36, 1); }

    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      .svg-float, .svg-sway, .bounce-in { animation: none !important; }
      .nav-links a, .day-tab, .todo-add-btn { transition: none !important; }
    }
  </style>
</head>
